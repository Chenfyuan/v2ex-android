<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <application
        android:name=".App"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity android:name=".MainActivity" android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="www.v2ex.com" android:pathPrefix="/t/" />
                <data android:scheme="https" android:host="v2ex.com" android:pathPrefix="/t/" />
                <data android:scheme="https" android:host="www.v2ex.com" android:pathPrefix="/member/" />
                <data android:scheme="https" android:host="v2ex.com" android:pathPrefix="/member/" />
                <data android:scheme="https" android:host="www.v2ex.com" android:pathPrefix="/go/" />
                <data android:scheme="https" android:host="v2ex.com" android:pathPrefix="/go/" />
                <data android:scheme="http" android:host="www.v2ex.com" android:pathPrefix="/t/" />
                <data android:scheme="http" android:host="v2ex.com" android:pathPrefix="/t/" />
            </intent-filter>
        </activity>
    </application>
</manifest>
